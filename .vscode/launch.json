{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask: run the app",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": { "FLASK_ENV": "development" }
    },
    {
      "name": "Build the recommendation model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_model.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Run the tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
