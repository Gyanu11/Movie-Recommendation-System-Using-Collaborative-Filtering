
# Which config to load: development | production | testing
FLASK_ENV=development

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_custom_secret_key_here

# Defaults to instance/site.db. For Postgres or MySQL in production:
DATABASE_URL=postgresql://user:password@host:5432/moviehub

# Default administrator, created on first run if it does not exist.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin123!

# Behaviour tuning (all optional)
WATCHLIST_MAX_ITEMS=20
SEARCH_MIN_QUERY_LENGTH=2
SEARCH_RESULT_LIMIT=24
RECOMMENDER_RESULT_LIMIT=12
PERSONAL_RESULT_LIMIT=12
HOMEPAGE_FEATURED_COUNT=15
ADMIN_PAGE_SIZE=25


TMDB_API_KEY=
